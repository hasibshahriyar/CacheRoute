NODE_ENV=development
PORT=3000

# PostgreSQL with pgvector
DATABASE_URL=postgresql://cacheroute:cacheroute@localhost:5432/cacheroute

# Redis (local or Upstash rediss://)
REDIS_URL=redis://localhost:6379

# Admin authentication token for /admin/* endpoints
ADMIN_TOKEN=cr_admin_dev_secret_token_change_in_prod

# Upstream LLM API Keys (Production)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Local / CI fault-injecting mock LLM URL
MOCK_LLM_URL=http://localhost:8081
MOCK_SECONDARY_LLM_URL=http://localhost:8081

# Cache & Threshold configuration
SEMANTIC_THRESHOLD=0.92
CACHE_TTL_SECONDS=86400
LOG_LEVEL=info
