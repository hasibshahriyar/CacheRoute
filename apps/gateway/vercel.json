{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "regions": ["iad1"],
  "functions": {
    "api/index.ts": {
      "maxDuration": 300,
      "includeFiles": "src/lua/**"
    }
  },
  "rewrites": [
    {
      "source": "/v1/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/debug/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/healthz",
      "destination": "/api/index"
    },
    {
      "source": "/readyz",
      "destination": "/api/index"
    },
    {
      "source": "/metrics",
      "destination": "/api/index"
    }
  ]
}
