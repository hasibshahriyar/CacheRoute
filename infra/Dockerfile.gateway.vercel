FROM node:24-slim

WORKDIR /app

ENV npm_config_onnxruntime_node_install_cuda=skip

COPY .npmrc package.json ./
COPY scripts ./scripts
COPY tsconfig.json ./
COPY tsconfig.build.json ./
COPY src ./src

RUN npm install --omit=dev && npx tsc -p tsconfig.build.json && node scripts/copy-assets.mjs

EXPOSE 3000
ENV PORT=3000
CMD ["node", "dist/server.js"]
